{
  "name": "lulu-mock-backend",
  "version": "0.0.1",
  "description": "LuLu mock backend",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^16.11.10",
    "eslint": "9.x",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "prettier": "3.3.3",
    "ts-node": "10.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "4.5.2",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "class-validator": "^0.13.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-flow": "^4.1.0",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "log4js": "^6.9.1",
    "moment": "^2.30.1",
    "mysql2": "^3.11.0",
    "node-fetch": "2",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "stack-trace": "^1.0.0-pre2",
    "typeorm": "0.3.20"
  },
  "scripts": {
    "dev:start": "cross-env NODE_ENV=development  ts-node-dev --respawn --transpile-only ./src/index.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "---Migration---": "typeorm migration:generate -n",
    "dev:schema:sync": "cross-env NODE_ENV=development ts-node ./node_modules/typeorm/cli.js schema:sync -d src/InitDataSource.ts",
    "dev:schema:drop": "cross-env NODE_ENV=development ts-node ./node_modules/typeorm/cli.js schema:drop -d src/InitDataSource.ts",
    "prepare": "husky",
    "---Data initilization---": "",
    "dev:data:init": "cross-env NODE_ENV=development  ts-node-dev --respawn --transpile-only ./src/InitData.ts"
  }
}
