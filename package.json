{
   "name": "lulu-mock-backend",
   "version": "0.0.1",
   "description": "LuLu mock backend.",
   "type": "commonjs",
   "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/node": "^16.11.10",
      "ts-node": "10.4.0",
      "ts-node-dev": "^2.0.0",
      "typescript": "4.5.2"
   },
   "dependencies": {
      "bcrypt": "^5.1.1",
      "body-parser": "^1.20.2",
      "class-validator": "^0.13.1",
      "cors": "^2.8.5",
      "cross-env": "^7.0.3",
      "dotenv": "^16.4.5",
      "dotenv-flow": "^4.1.0",
      "express": "^4.19.2",
      "express-fileupload": "^1.5.0",
      "helmet": "^7.1.0",
      "jsonwebtoken": "^9.0.2",
      "moment": "^2.30.1",
      "mysql2": "^3.11.0",
      "reflect-metadata": "^0.2.2",
      "typeorm": "0.3.20",
      "winston": "^3.13.1"
   },
   "scripts": {
      "dev:start": "cross-env NODE_ENV=development  ts-node-dev --respawn --transpile-only ./src/index.ts",
      "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
      "---Migration---": "typeorm migration:generate -n",
      "dev:schema:sync": "cross-env NODE_ENV=development ts-node ./node_modules/typeorm/cli.js schema:sync -d src/InitDataSource.ts",
      "dev:schema:drop": "cross-env NODE_ENV=development ts-node ./node_modules/typeorm/cli.js schema:drop -d src/InitDataSource.ts"
   }
}
